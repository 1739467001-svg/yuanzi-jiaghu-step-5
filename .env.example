# Optional. Without these values, the app uses explicitly labelled local demo replies.
ATOM_LLM_BASE_URL=https://api.openai.com/v1
ATOM_LLM_API_KEY=
ATOM_LLM_MODEL=
# Maximum requests per local server session (restart resets the counter).
ATOM_SESSION_LIMIT=100

# Local operations backend (demo only, not a production permission system).
# Admin requests must send the x-atom-admin header with this value.
ATOM_ADMIN_TOKEN=atom-local-demo
# Optional. Where publication overrides and the audit log are stored.
ATOM_DATA_DIR=data

# Model budget (persistent ledger in data/usage-ledger.json; survives restarts).
# Daily budget in currency units; 0 disables the amount limit. Reaching 80% is a
# warning (background AI activity should slow down), 100% pauses new model calls
# (exhibition browsing and human chat keep working). Prices are per 1M tokens.
ATOM_DAILY_BUDGET=0
ATOM_DAILY_CALL_LIMIT=200
ATOM_MAX_CONCURRENT=3
ATOM_PRICE_IN_PER_MTOK=0
ATOM_PRICE_OUT_PER_MTOK=0

# Online world room. Capacity defaults to 20; when full, newcomers queue FIFO.
# Reclaim window: a disconnected player keeps their slot for this long so a quick
# reconnect reclaims it before the slot is offered to the queue.
ATOM_ROOM_CAPACITY=20
ATOM_RECLAIM_WINDOW_MS=15000

# Production server (node server/index.mjs; see docs/DEPLOY.md).
PORT=8080
HOST=0.0.0.0
# ATOM_DATA_DIR=data
# Comma-separated extra WebSocket origins; same-origin is always allowed.
# ATOM_ALLOWED_ORIGINS=https://your.domain.com

# Optional embedding provider (OpenAI-compatible). When configured, memory recall
# and work retrieval use vector cosine similarity; otherwise the local bigram
# TF-IDF ranking is used. Embeddings are cached in data/embedding-cache.json.
ATOM_EMBEDDING_BASE_URL=
ATOM_EMBEDDING_API_KEY=
ATOM_EMBEDDING_MODEL=text-embedding-3-small

# External identity provider (production auth). Set ATOM_AUTH_MODE=external to
# require community-account tokens; local registration stays available in local mode.
# JWKS mode (RS/ES signed JWT):
ATOM_AUTH_MODE=local
ATOM_AUTH_JWKS_URL=
ATOM_AUTH_ISSUER=
ATOM_AUTH_AUDIENCE=
# Or introspection mode (RFC 7662):
ATOM_AUTH_INTROSPECT_URL=
ATOM_AUTH_CLIENT_ID=
ATOM_AUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Docker 云部署（docker compose；详见 docs/DEPLOY.md 第 11 节）
# ---------------------------------------------------------------------------
# 有域名并启用自动 HTTPS 时填写（docker compose --profile tls up -d）
DOMAIN=
# 前端分离部署（如 Vercel）时填前端域名，多个用逗号；同源部署留空
ATOM_ALLOWED_ORIGINS=
# 多房间分流，格式：id:名称:容量,id:名称:容量（留空为单房间）
ATOM_ROOMS=
