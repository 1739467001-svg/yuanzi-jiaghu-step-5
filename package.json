    "validate:content": "node --test tests/content.test.mjs",
    "test:e2e-mp": "node scripts/smoke-multiplayer.mjs",
    "test:e2e-model": "node scripts/smoke-model.mjs",
    "test:e2e-queue": "node scripts/smoke-queue.mjs",
    "test:e2e-glb": "node scripts/smoke-glb.mjs",
    "start": "node server/index.mjs",
    "test:e2e-rooms": "node scripts/smoke-rooms.mjs",
    "soak": "node scripts/soak-world.mjs",
    "soak:browser": "node scripts/soak-browser.mjs",
    "soak:long": "ATOM_SOAK_MINUTES=120 ATOM_SOAK_PLAYERS=24 node scripts/soak-world.mjs",
    "soak:72h": "ATOM_SOAK_MINUTES=4320 ATOM_SOAK_PLAYERS=24 node scripts/soak-world.mjs",
    "verify:repo": "node scripts/verify-repo.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
